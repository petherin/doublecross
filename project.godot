; Engine configuration file.
config_version=5

[application]

config/name="Double Cross"
config/version="dev"
config/description="Two rival agents. One secret base. Hide traps, grab the intel, get out."
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Settings="*res://scripts/core/settings.gd"
Net="*res://scripts/core/net.gd"
Sound="*res://scripts/core/sound.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

